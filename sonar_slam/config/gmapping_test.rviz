Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views

Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Count: 20
    
    - Class: rviz/Map
      Name: Map
      Topic: /map
      Alpha: 0.7
      Color Scheme: map
    
    - Class: rviz/LaserScan
      Name: Sonar Scan
      Topic: /sonar/scan
      Size (m): 0.05
      Style: Points
    
    - Class: rviz/TF
      Name: TF Frames
    
    - Class: rviz/RobotModel
      Name: Robot Model
      Robot Description: robot_description
    
    - Class: rviz/Odometry
      Name: Odometry
      Topic: /odom
  
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 10