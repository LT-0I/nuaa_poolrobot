Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 40; 40; 40
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Color: 90; 90; 90
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 40
      Offset:
        X: 0
        Y: 0
        Z: 0
      Value: true
    - Class: rviz/PointCloud2
      Enabled: true
      Name: BaseMap
      Topic: /reloc/map
      Unreliable: false
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Decay Time: 0
      Color: 200; 200; 200
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Queue Size: 10
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: Trajectory
      Topic: /reloc/trajectory
      Color: 30; 144; 255
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.08
      Pose Style: None
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Fixes
      Marker Topic: /reloc/fixes
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Name: Status
      Marker Topic: /reloc/status
      Queue Size: 100
      Value: true
    - Class: rviz/Pose
      Enabled: true
      Name: RobotPose
      Topic: /reloc/robot_pose
      Shape: Arrow
      Color: 50; 255; 50
      Alpha: 1
      Shaft Length: 0.8
      Shaft Radius: 0.12
      Head Length: 0.35
      Head Radius: 0.25
      Queue Size: 10
      Value: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 38
      X: 9
      Y: 1.5
      Angle: 0
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
