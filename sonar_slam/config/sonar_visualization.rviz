# config/sonar_visualization.rviz
Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: rviz::VisualizationManager
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Cell Size: 0.5
      Color: 160; 160; 164
      Reference Frame: map
    
    # ==================== 原始声纳点云 ====================
    - Class: rviz/PointCloud2
      Name: Raw Sonar Points
      Enabled: true
      Topic: /sonar/pointcloud
      Style: Points
      Size (Pixels): 2
      Alpha: 0.6
      Color Transformer: Intensity
      Min Color: 30; 30; 255
      Max Color: 255; 255; 255
      Value: true
    
    # ==================== 滤波后点云 ====================
    - Class: rviz/PointCloud2
      Name: Filtered Points
      Enabled: true
      Topic: /sonar/filtered_pointcloud
      Style: Points
      Size (Pixels): 3
      Alpha: 0.7
      Color Transformer: FlatColor
      Color: 0; 255; 0
    
    # ==================== 占据地图 ====================
    - Class: rviz/Map
      Name: Occupancy Map
      Enabled: true
      Topic: /sonar/map
      Alpha: 0.6
      Color Scheme: map
      Draw Behind: false
    
    # ==================== 代价地图 ====================
    - Class: rviz/Map
      Name: Cost Map
      Enabled: true
      Topic: /sonar/costmap
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
    
    # ==================== TF变换 ====================
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Names: true
      Frame Timeout: 15
  
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetGoal
    - Class: rviz/SetInitialPose
  
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Target Frame: map
      Distance: 20.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 0.5