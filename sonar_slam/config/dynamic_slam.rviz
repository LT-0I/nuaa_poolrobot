Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views

Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 10
      Color: 128; 128; 128
      Alpha: 0.5
    
    - Class: rviz/Map
      Name: Map
      Topic: /map
      Alpha: 0.7
      Color Scheme: map
    
    - Class: rviz/Marker
      Name: Frontiers
      Topic: /frontiers
    
    - Class: rviz/Marker
      Name: Goal
      Topic: /current_goal
    
    - Class: rviz/Marker
      Name: Scan Points
      Topic: /scan_points  # 需要添加这个发布
    
    - Class: rviz/PointCloud2
      Name: Sonar PointCloud
      Topic: /sonar/filtered_pointcloud
      Size (Pixels): 3
      Style: Points
    
    - Class: rviz/TF
      Name: TF
      Marker Scale: 0.5
    
    - Class: rviz/RobotModel
      Name: Robot Model
      Robot Description: robot_description
    
    - Class: rviz/Odometry
      Name: Odometry
      Topic: /wheel_odom
  
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30.0
  
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>