<?xml version="1.0"?>
<package format="2">
  <name>sonar_slam</name>
  <version>0.0.1</version>
  <description>Sonar SLAM package for underwater cleaning robot</description>
  
  <maintainer email="your-email@example.com">Your Name</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- 构建依赖 -->
  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>mars_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>image_transport</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>pcl_conversions</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>eigen</build_depend>
  
  <build_depend>message_generation</build_depend>
  <build_depend>std_srvs</build_depend>

    <!-- 其他系统依赖 -->
  <build_depend>libopencv-dev</build_depend>
  <build_depend>libpcl-dev</build_depend>
  <build_depend>libeigen3-dev</build_depend>
  <build_depend>libboost-all-dev</build_depend>

  <build_depend>sonar_return_home_file_detector</build_depend>

  <!-- 运行时依赖 -->
  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>mars_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>pcl_conversions</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>eigen</exec_depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>std_srvs</exec_depend>

 
  <exec_depend>libopencv-dev</exec_depend>
  <exec_depend>libpcl-dev</exec_depend>
  <exec_depend>libeigen3-dev</exec_depend>
  <exec_depend>libboost-all-dev</exec_depend>

  <exec_depend>sonar_return_home_file_detector</exec_depend>

  <!-- 输出 -->
  <export>
    <rosdoc config="rosdoc.yaml" />
  </export>
</package>