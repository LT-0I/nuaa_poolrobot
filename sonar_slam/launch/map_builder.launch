<!-- sonar_slam/launch/build_map.launch -->
<launch>
    <!-- Sonar Data Processor -->
    <node name="sonar_map_builder" pkg="sonar_slam" type="sonar_map_builder" output="screen">
        <!-- 数据文件路径 -->
        <param name="data_file" value="$(find sonar_slam)/data/20251127-160606453.bin" />
        
        <!-- 参数配置 -->
        <param name="max_range" value="15.0" />
        <param name="min_range" value="0.2" />
        <param name="min_intensity" value="100.0" />
        <param name="map_resolution" value="0.05" />
        <param name="map_width" value="100" />
        <param name="map_height" value="100" />
        <param name="map_origin_x" value="-2.5" />
        <param name="map_origin_y" value="-2.5" />
    </node>
    
    <!-- RViz 可视化 -->
    <node name="rviz" pkg="rviz" type="rviz" 
          args="-d $(find sonar_slam)/config/map_builder.rviz" />
    
    <!-- 启动静态 TF -->
    <node pkg="tf" type="static_transform_publisher" name="map_to_odom" 
          args="0 0 0 0 0 0 map odom 100" />
</launch>

 