<launch>
  <!-- ====================================================================
       下水直线前进 + 定点声呐扫描 + 自动建图 一键入口
       (沿边运动学困难 -> 改直线; 声呐扫描/记文件/自动建图 均复用现有节点)
       逻辑: 直线前进固定距离 -> 停 -> 开声呐扫一圈 -> 记文件
             -> 再直线前进 ... 共 num_positions 个点 -> 采完自动拼图(两遍出两图)
       与 wall_follow_sonar_scan.launch 的唯一区别:
         move_controller 置 wall_follow_enable=false => 直行模式
           (外环距墙/平行环停用 C=0 + 拐角停转关 -> 纯内环 IMU 航向保持直线; 不读超声侧距)
         声呐扫描一圈/记文件/自动建图 与沿边版完全一致(main 基线扫描内核 + pintu 两图拼接)。
       ....................................................................
       前置(本 launch 不含, 须先起): 硬件驱动 serial_server.launch
         (发 /imu_heading /ultra_data, 收 /cmd_vel; 直行 IMU 航向保持须 /imu_heading)
       Ping360 声呐串口默认 /dev/ttyACM0
       ....................................................................
       ⚠ 安全: 直行模式无前墙避障(不读超声、不停转)。停车靠 move_straight 里程停点 +
         每段 timeout; 机器人不会自动避开正前方池壁 -> 操作员须确保
         num_positions * move_distance < 可用直线水域长度; 可靠停车仍以断电为准。
       ====================================================================
       命名空间注意(重要, 同沿边版):
         move_controller_node 用默认 NodeHandle => 读"全局" /xxx, 整定参数必须放 <launch> 顶层 <param>;
         multi_position_sonar_mapper 用私有 NodeHandle nh("~") => 读"私有" ~xxx, 参数放 <node> 内。
       ==================================================================== -->

  <!-- ===== 声呐 / 采集参数 (mapper 私有命名空间 phase1/) ===== -->
  <arg name="serial_port"       default="/dev/ttyACM0"/>  <!-- Ping360 声呐串口 -->
  <arg name="baudrate"          default="115200"/>
  <arg name="range_level"       default="s5"/>            <!-- 声呐量程档; 默认 s5(≈14m)匹配 pintu 已验证采集档; 按实际水域/建图范围调(需覆盖待测墙面) -->
  <arg name="num_positions"     default="5"/>             <!-- 采集停点数(3-50); 默认 5=pintu 参考采集点数 -->
  <arg name="move_distance"     default="4.0"/>           <!-- 每段直线前进距离(米); 默认 4.0(pintu 相邻点 ~4.5m); 按实际停点间距调 -->
  <arg name="scan_duration"     default="100.0"/>         <!-- ★每点扫描硬超时(秒): 到点即强制存盘并前进、不管扫没扫满! 必须 >= 声呐实测扫满一圈耗时。默认 100=代码原值(保守); 权威值 95.0; 现场看日志"完成第N圈扫描!耗时X秒"取其 1.5~2 倍 -->
  <arg name="wait_duration"     default="60.0"/>          <!-- 换点移动看门狗(秒): move_straight timeout=max(本值, move_distance*15) -->
  <arg name="sweep_pace_sec"    default="0.1"/>           <!-- 扫描每角步间距(秒); 默认0.1=原值(零行为变化)。每圈400步=>0.1×400=40s固定死时间地板(回波已在等待循环收完, 此为纯角间idle); 现场可下调(如0.03)缩短单圈扫描, 不改点云内容(同400角/同range/同采样)。免重编。代码夹限[0,1] -->
  <!-- 注: required_circles 故意不暴露 —— multi_position_sonar_mapper.cpp 内硬写=1, 每点恒扫 1 圈 -->

  <!-- ===== 扫描前"泵关+转停"守门 (mapper 私有命名空间, 安全项) =====
       声呐入水扫描要求泵关且车停(CLAUDE.md 安全红线)。每次开扫前观测 /cmd_vel 确认 linear.y(泵)与运动均归零并 settle。
       与 move_controller "行走开泵/停车关泵/剩0.3m提前关" 配合: 车停 => 泵应自动归零, 本守门只做显式校验+沉降, 不发指令。 -->
  <arg name="pump_guard_enable"      default="true"/>   <!-- 守门总开关; false=直接放行(仅调参/无泵离线时用) -->
  <arg name="pump_settle_sec"       default="2.5"/>    <!-- 确认/超时后物理转停沉降等待(秒); 在扫描计时前, 不吃 scan_duration -->
  <arg name="pump_off_thresh"       default="0.02"/>   <!-- |linear.y| 判泵关阈值 -->
  <arg name="pump_stopped_thresh"   default="0.02"/>   <!-- |linear.x|/|angular.z| 判车停阈值 -->
  <arg name="pump_guard_timeout_sec" default="6.0"/>   <!-- 确认最长等待(秒); 到点仍未确认则打 ERROR 后【继续扫】(用户拍板: 报错仍扫, 不阻塞采集; 该点落 pump_gate_log.csv confirmed=0) -->
  <arg name="pump_guard_stable_sec"  default="0.5"/>   <!-- 条件需连续保持此时长才算确认(秒) -->
  <arg name="pump_cmd_fresh_sec"     default="0.3"/>   <!-- /cmd_vel 新鲜判据(秒); 须 < stable, 否则发布者死掉后陈旧末值也能假确认; 代码会钳位保证 < stable -->

  <!-- 直行模式: 无需人工对齐墙/无需找墙; 直接对准前进方向下水即可。acquire_wall_first 恒 false。 -->
  <arg name="acquire_wall_first" default="false"/>
  <arg name="acquire_distance"  default="0.5"/>

  <!-- ===== 拼图开关 (两图, 算法=pintu pinjie-auto2) ===== -->
  <arg name="enable_stitch"     default="true"/>          <!-- true=采集全部停点完成后自动离线拼图【两遍出两图】: <session>/stitching_loc.pcd(定位) + stitching_view.pcd(显示); false=只采集不拼。拼图需机上装 open3d/scipy/pandas/numpy -->
  <arg name="stitch_min_inner_loc"  default="60"/>        <!-- 定位图(loc, 稠密)逐帧滤波内圈强度门; 供 g 单点声呐定位 ICP -->
  <arg name="stitch_min_inner_view" default="90"/>        <!-- 显示图(view, 干净)逐帧滤波内圈强度门; 供 g rviz 显示底图。其余7个滤波参数两图通用, 可用 ~stitch_* 私有参数覆盖 -->

  <!-- ===== 直行 / 运动参数 (move_controller 读全局命名空间) ===== -->
  <arg name="wall_follow_enable" default="false"/>        <!-- ★false=直行模式(本 launch 目的): 纯 IMU 航向保持直线, 不读超声侧距、不拐角停转。true 才是沿边(那应改用 wall_follow_sonar_scan.launch) -->
  <arg name="enable_corner"     default="false"/>         <!-- 直行模式下拐角停转关(冗余显式钉住: 防吃 rosmaster 残留; wall_follow_enable=false 时构造期也会强制关) -->
  <arg name="speed"             default="0.25"/>          <!-- 前进线速度(m/s); 默认0.25(0614实测能走直、高于~0.27履带打滑侧滑临界) -->
  <arg name="pump_speed"        default="0.4"/>           <!-- 水泵占空(下水吸底, 无推力); 纯建图可设 0 -->
  <arg name="log_period_sec"    default="1.0"/>           <!-- 行走日志写盘周期(秒); 诊断可 :=0.05 全速记 -->
  <!-- ===== 直行 IMU 航向环整定 (现场调直线度的主旋钮; 全是 move_controller 全局参数, 改不用重编) =====
       默认值 = 0614 泳池实测走直好值, 与 a 分支走直/矩形同源同款 IMU 航向 PD + 同一 VCU 驱动映射。
       现场直接 `roslaunch sonar_slam straight_line_sonar_scan.launch heading_kp:=1.2 heading_kd:=0.8 ...` 即调, 免重编。
       建议调参顺序: (1) 先 track_bias(驱动侧)治机械平移偏(车总偏一侧) -> (2) heading_kp/kd 治航向抖/软 -> (3) heading_ki 收系统性残余。
       ⚠ 全局参数残留: 下面 <param> 把 heading_*/speed_max/softstart 写进全局参数服务器, roslaunch 退出不自动清;
         同一 roscore 先跑本 launch(调过参)再跑 wall_follow_sonar_scan.launch 会串味(尤其 heading_sign 极性)。
         切 launch 前请【重启 roscore】或知悉残留; wall_follow 侧已补钉 heading_sign 兜底。
       ⚠ track_bias(治"车总往一边偏"的头号旋钮)是【驱动】参数、不在本 launch —— 在驱动 /cmd_vel 入口施加:
         track_bias>0 => 右轮 x(1-tb) 减速、左轮 x(1+tb) 加速 => 车向右偏 => 补偿"车总向左偏"。任何发 /cmd_vel 的控制器共享。起驱动时传:
           roslaunch mars_serial_server serial_server.launch track_bias:=0.1
           (实测0.1; 语义见 serial_server.launch "右减左增、治总向左偏"; 故【车总偏左则↑、偏右则↓(可进负)】, 范围[-0.30,+0.30]对称)
         omega_gain(6.4)/motor_scale(230) 同在驱动侧、一般不动。 -->
  <arg name="heading_kp"          default="1.0"/>   <!-- 航向P增益: 纠偏太软(回正慢/走偏)则↑, 抖动/画龙则↓; 过大->发散画龙(即时可辨、断电即停) -->
  <arg name="heading_kd"          default="1.0"/>   <!-- 航向D增益(阻尼): 抖/超调↑, 反应迟钝↓ -->
  <arg name="heading_omega_limit" default="0.30"/>  <!-- 角速度命令饱和上限; 默认0.30已是代码硬顶(夹≤0.3)、只能【下调】降转向权限、上调无效; 一般不动 -->
  <arg name="heading_ki"          default="0.0"/>   <!-- 航向I增益: 仅有恒定残余偏航(系统性)才少量给; 默认0 -->
  <arg name="heading_i_clamp"     default="0.05"/>  <!-- 积分限幅(抗饱和); 配合 heading_ki -->
  <arg name="heading_tau_d"       default="0.2"/>   <!-- D项低通时间常数(秒); IMU噪声大导致D抖→↑更平滑 -->
  <arg name="heading_yaw_timeout" default="0.5"/>   <!-- /imu_heading 陈旧超时(秒)→退化 odom 守航向; ★安全项:建议[0.3,1.0]; 勿设0/负(永久退odom、失去IMU直行)或过大(抱冻结航向猛冲); 代码暂无夹限 -->
  <arg name="heading_sign"        default="1"/>     <!-- ★航向负反馈极性: 只填整数 +1 或 -1(下面 param 已锁 type=int); 填反=正反馈会原地打转/跑偏! 默认+1(实测负反馈) -->
  <arg name="softstart_sec"       default="1.5"/>   <!-- 起步 速度+航向 斜坡(秒): 防起步瞬间侧偏; 起步过猛→↑ -->
  <arg name="speed_max"           default="0.30"/>  <!-- ★前进安全上限(m/s); 实际速度=min(speed,speed_max), 设 speed 更大也只走到此值; 代码再硬夹≤0.35; >0.27 易履带打滑侧滑, 谨慎↑ -->
  <!-- 注: 直行模式下 wall_* / corner_* / reacquire_* / findwall_* 全 inert(外环+拐角已停用), 故不设;
       move_controller 读不到即用代码默认值, 不影响直行。 -->

  <!-- move_controller 整定参数: 必须置"全局"(顶层 <param>), 否则被忽略 -->
  <param name="wall_follow_enable" value="$(arg wall_follow_enable)"/>
  <param name="enable_corner"      value="$(arg enable_corner)"/>
  <param name="speed"              value="$(arg speed)"/>
  <param name="pump_speed"         value="$(arg pump_speed)"/>
  <param name="log_period_sec"     value="$(arg log_period_sec)"/>
  <!-- 直行 IMU 航向环整定 (对应上面同名 arg; 现场 roslaunch ... heading_kp:=1.2 即改, 免重编。
       构造期只读一次: 须节点起来前生效; 光 `rosparam set` 而不重启节点【不生效】, 须重跑 roslaunch) -->
  <param name="heading_kp"          value="$(arg heading_kp)"/>
  <param name="heading_kd"          value="$(arg heading_kd)"/>
  <param name="heading_omega_limit" value="$(arg heading_omega_limit)"/>
  <param name="heading_ki"          value="$(arg heading_ki)"/>
  <param name="heading_i_clamp"     value="$(arg heading_i_clamp)"/>
  <param name="heading_tau_d"       value="$(arg heading_tau_d)"/>
  <param name="heading_yaw_timeout" value="$(arg heading_yaw_timeout)"/>
  <param name="heading_sign"        value="$(arg heading_sign)" type="int"/>
  <param name="softstart_sec"       value="$(arg softstart_sec)"/>
  <param name="speed_max"           value="$(arg speed_max)"/>

  <!-- 运动控制器: 提供 /move_controller/move_straight (直行模式) + /move_controller/find_wall(直行不用) -->
  <node pkg="sonar_slam" type="move_controller_node" name="move_controller_node" output="screen"/>

  <!-- 声呐采集 mapper: 直线走固定距离->停->扫一圈->记文件(main 基线扫描内核), 落智能会话目录; 参数走私有 ~ -->
  <node pkg="sonar_slam" type="multi_position_sonar_mapper" name="multi_position_sonar_mapper" output="screen">
    <param name="serial_port"             value="$(arg serial_port)"/>
    <param name="baudrate"                value="$(arg baudrate)"/>
    <param name="range_level"             value="$(arg range_level)"/>
    <param name="sweep_pace_sec"          value="$(arg sweep_pace_sec)"/>
    <param name="phase1/enabled"          value="true"/>
    <param name="phase1/num_positions"    value="$(arg num_positions)"/>
    <param name="phase1/move_distance"    value="$(arg move_distance)"/>
    <param name="phase1/scan_duration"    value="$(arg scan_duration)"/>
    <param name="phase1/wait_duration"    value="$(arg wait_duration)"/>
    <param name="phase1/acquire_wall_first" value="$(arg acquire_wall_first)"/>
    <param name="phase1/acquire_distance" value="$(arg acquire_distance)"/>
    <param name="enable_stitch"           value="$(arg enable_stitch)"/>
    <!-- 扫描前"泵关+转停"守门 (私有 ~ 命名空间, 见顶部 arg 说明) -->
    <param name="pump_guard_enable"       value="$(arg pump_guard_enable)"/>
    <param name="pump_settle_sec"         value="$(arg pump_settle_sec)"/>
    <param name="pump_off_thresh"         value="$(arg pump_off_thresh)"/>
    <param name="pump_stopped_thresh"     value="$(arg pump_stopped_thresh)"/>
    <param name="pump_guard_timeout_sec"  value="$(arg pump_guard_timeout_sec)"/>
    <param name="pump_guard_stable_sec"   value="$(arg pump_guard_stable_sec)"/>
    <param name="pump_cmd_fresh_sec"      value="$(arg pump_cmd_fresh_sec)"/>
  </node>

  <!-- 拼图节点(离线后处理, 受 enable_stitch 门控): 订阅 /sonar_scan/session_done -> 对会话目录跑 sonar_stitch.py 两遍
       -> 出 <session>/stitching_loc.pcd(MIN_INNER=60 定位) + stitching_view.pcd(MIN_INNER=90 显示)
       -> 发 /sonar_stitch/cloud(RViz, =view 干净图) /sonar_stitch/done。算法=pintu pinjie-auto2 逐字节。
       需机上装 open3d/scipy/pandas/numpy; 缺依赖会打 ASCII 提示并跳过, 不影响采集。 -->
  <node if="$(arg enable_stitch)" pkg="sonar_slam" type="sonar_stitch_node.py"
        name="sonar_stitch_node" output="screen">
    <param name="stitch_min_inner_loc"  value="$(arg stitch_min_inner_loc)"/>
    <param name="stitch_min_inner_view" value="$(arg stitch_min_inner_view)"/>
  </node>

</launch>
