<?xml version="1.0"?>
<launch>
    <!-- 参数设置 -->
    <arg name="data_file" default="$(find sonar_slam)/data/20251127-160606453.bin" />
    <arg name="mode" default="static" /> <!-- static或dynamic -->
    <arg name="rviz" default="true" />
    <arg name="use_gmapping" default="false" />
    
    <!-- 启动ROS参数服务器 -->
    <rosparam command="load" file="$(find sonar_slam)/config/slam_params.yaml" />
    
    <!-- 根据模式选择启动方式 -->
    <group if="$(eval mode == 'static')">
        <!-- 静态建图模式：直接从文件构建地图 -->
        <node pkg="sonar_slam" type="sonar_map_builder" name="sonar_map_builder" output="screen">
            <param name="data_file" value="$(arg data_file)" />
            <param name="max_range" value="10.0" />
            <param name="min_range" value="0.2" />
            <param name="min_intensity" value="50.0" />
            <param name="map_resolution" value="0.05" />
            <param name="debug_mode" value="true" />
            <!-- 发布初始地图 -->
            <remap from="sonar_occupancy_map" to="/map" />
            <remap from="sonar_map_pointcloud" to="/sonar_cloud" />
            <!-- 为了与sonar_slam_node对接，需要发布/sonar_poses -->
            <param name="publish_poses" value="true" />
            <remap from="sonar_poses" to="/sonar_poses" />
        </node>
    </group>
    
    <group if="$(eval mode == 'dynamic')">
        <!-- 动态建图模式：自主探索 -->
        
        <!-- 方案1：使用sonar_map_builder处理文件数据 -->
        <node pkg="sonar_slam" type="sonar_map_builder" name="sonar_map_builder" output="screen">
            <param name="data_file" value="$(arg data_file)" />
            <param name="max_range" value="10.0" />
            <param name="min_range" value="0.2" />
            <param name="min_intensity" value="50.0" />
            <param name="map_resolution" value="0.05" />
            <param name="debug_mode" value="true" />
            <!-- 发布给sonar_slam_node的话题 -->
            <remap from="sonar_occupancy_map" to="/initial_map" />
            <remap from="sonar_map_pointcloud" to="/sonar_cloud" />
            <param name="publish_poses" value="true" />
            <remap from="sonar_poses" to="/sonar_poses" />
        </node>
        
        <!-- 方案2：或者使用sonar_data_processor + static_mapper -->
        <!--
        <node pkg="sonar_slam" type="sonar_data_processor" name="sonar_data_processor" output="screen">
            <param name="data_file" value="$(arg data_file)" />
            <param name="max_range" value="10.0" />
            <param name="min_range" value="0.2" />
            <param name="intensity_threshold" value="50.0" />
            <remap from="output_scan" to="/scan" />
        </node>
        
        <node pkg="sonar_slam" type="static_mapper" name="static_mapper" output="screen">
            <param name="map_resolution" value="0.05" />
            <param name="map_width" value="200" />
            <param name="map_height" value="200" />
            <remap from="input_scan" to="/scan" />
            <remap from="output_map" to="/initial_map" />
        </node>
        -->
        
        <!-- 启动动态SLAM节点（自主探索） -->
        <node pkg="sonar_slam" type="sonar_slam_node" name="sonar_slam_node" output="screen">
            <!-- 建图参数 -->
            <param name="update_interval" value="30.0" /> <!-- 30秒更新一次 -->
            <param name="map_resolution" value="0.05" />
            <param name="map_width" value="200" />
            <param name="map_height" value="200" />
            <param name="map_origin_x" value="-5.0" />
            <param name="map_origin_y" value="-5.0" />
            <param name="stability_threshold" value="10" />
            
            <!-- 导航参数 -->
            <param name="frontier_weight_distance" value="0.3" />
            <param name="frontier_weight_unknown" value="0.7" />
            <param name="max_linear_speed" value="0.2" />
            <param name="max_angular_speed" value="0.5" />
            <param name="goal_tolerance" value="0.3" />
            
            <!-- 输入话题映射 -->
            <remap from="/sonar_poses" to="/sonar_poses" />
            <!-- 如果没有真实的odom和imu，使用模拟数据 -->
            <remap from="/wheel_odom" to="/odom" />
            <remap from="/imu_data" to="/imu" />
        </node>
        
        <!-- 启动gmapping（可选） -->
        <group if="$(arg use_gmapping)">
            <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
                <param name="base_frame" value="base_link"/>
                <param name="odom_frame" value="odom"/>
                <param name="map_frame" value="map"/>
                <param name="delta" value="0.05"/>
                <param name="maxUrange" value="10.0"/>
                <remap from="scan" to="/scan"/>
            </node>
        </group>
        
        <!-- 发布模拟的TF变换和传感器数据 -->
        <include file="$(find sonar_slam)/launch/simulated_robot.launch" />
    </group>
    
    <!-- 启动RViz -->
    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz" 
              args="-d $(find sonar_slam)/config/slam_view.rviz" />
    </group>
    
</launch>