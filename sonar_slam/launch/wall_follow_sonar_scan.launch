<launch>
  <!-- ====================================================================
       目标1 step4: 沿边行驶 + 声呐采集 一键入口 (独立于裸沿边 1-3, 互不影响)
       逻辑(复用 main 声呐节点): 沿边走固定距离 -> 停 -> 开声呐扫一圈 -> 记文件
                                 -> 再走 ... (拐弯停车不计入固定距离)
       移动委托 /move_controller/move_straight (本分支=沿边串级控制器)
       声呐扫一圈/记文件 完全依照 main; 文件落智能会话目录 ~/sonar_logs/scan_<时间>/
       ....................................................................
       前置(本 launch 不含, 须先起): 硬件驱动 serial_server.launch
         (发 /imu_heading /ultra_data, 收 /cmd_vel; 否则沿边控制器拿不到航向/超声)
       Ping360 声呐串口默认 /dev/ttyACM0; 沿边整定参数沿用 1-3 调好的值(下方 arg)
       ====================================================================
       命名空间注意(重要):
         move_controller_node 用默认 NodeHandle => 读"全局"命名空间 /xxx,
           故其整定参数必须放在 <launch> 顶层 <param>(全局), 放进 <node> 内会变私有 /move_controller_node/xxx 而被静默忽略;
         multi_position_sonar_mapper 用私有 NodeHandle nh("~") => 读"私有" ~xxx,
           故其参数放进该 <node> 内 <param>(私有), 正确。
       ==================================================================== -->

  <!-- ===== 声呐 / 采集参数 (mapper 私有命名空间 phase1/) ===== -->
  <arg name="serial_port"       default="/dev/ttyACM0"/>  <!-- Ping360 声呐串口 -->
  <arg name="baudrate"          default="115200"/>
  <arg name="range_level"       default="s0"/>            <!-- 声呐量程档 s0=4m -->
  <arg name="num_positions"     default="6"/>             <!-- 采集停点数(3-50) -->
  <arg name="move_distance"     default="2.0"/>           <!-- 每段沿边前进距离(米); 拐弯停不计入 -->
  <arg name="scan_duration"     default="100.0"/>         <!-- ★每点扫描硬超时(秒): 到点即强制存盘并前进、不管扫没扫满! 必须 >= 声呐实测扫满一圈耗时, 调小会存出不完整坏档。默认 100=代码原值(保行为不变、偏保守); 操作说明权威值=95.0; 现场看日志"完成第N圈扫描!耗时X秒"实测后取其 1.5~2 倍 -->
  <arg name="wait_duration"     default="60.0"/>          <!-- 换点移动看门狗(秒): move_straight timeout=max(本值, move_distance*15)。默认 60=代码原值; 操作说明权威值=50.0 -->
  <!-- 注: required_circles 故意不暴露 —— 多位置流程在 multi_position_sonar_mapper.cpp:2986 被硬写=1, 调了不生效(暴露会误导), 每点恒扫 1 圈 -->

  <!-- acquire_wall_first 默认 false(保守): 须人工把机器人对齐到墙边(墙在右)再启动 -> mapper 直接进扫-走循环。
       置 true=丢角落自启(启动即旋转找墙+沿边 acquire_distance 米再扫); 仅在 step3 找墙现场验过、右超声映射标定后才用。 -->
  <arg name="acquire_wall_first" default="false"/>
  <arg name="acquire_distance"  default="0.5"/>           <!-- acquire_wall_first=true 时, 找墙对齐后先沿边的距离(米) -->

  <!-- ===== 拼图开关 ===== -->
  <arg name="enable_stitch"     default="true"/>          <!-- true=采集全部停点完成后自动离线拼图(出 <session>/stitching.pcd); false=只采集不拼(行为同接入前)。拼图需机上装 open3d/scipy/pandas -->

  <!-- ===== 沿边整定参数 (move_controller 读全局命名空间; 填 step1-3 调好的值, 默认=代码现场默认) ===== -->
  <arg name="wall_align"        default="2.0"/>           <!-- 目标离墙距离(米) [step1 核心]; 默认2.0(据实际实验取2m) -->
  <arg name="wall_k_dist"       default="0.20"/>          <!-- 距墙距离环增益 [step1] -->
  <arg name="wall_k_par"        default="0.60"/>          <!-- 平行(姿态)环增益 [step1] -->
  <arg name="wall_off_max"      default="0.10"/>          <!-- 距/平行环折算航向偏置上限(rad) [step1] -->
  <arg name="speed"             default="0.25"/>          <!-- 沿边前进线速度(m/s) [step1] -->
  <arg name="pump_speed"        default="0.4"/>           <!-- 水泵占空(下水推进) [step1] -->
  <arg name="corner_use_wall_dist" default="true"/>      <!-- 前墙触发距离跟随 wall_align(走够离墙距即停转) [step2] -->
  <arg name="enable_corner"     default="true"/>          <!-- 绕角停-转总开关; 须显式钉住: move_controller 构造期读全局 /enable_corner, 不钉会吃 rosmaster 残留(如 §1 单测设过 false 未重启) -->

  <!-- ===== 内环 IMU 航向 PD + 外环补充 + 数据健康门 + 拐角 + 卡死看门狗 (0701 全部暴露; 默认=0622实测起点, 现场整定) ===== -->
  <!-- 内环(IMU航向PD): 0614实测直行好的值作起点; 现场按 CSV(e_head/u) 整定 -->
  <arg name="heading_kp"           default="1.0"/>          <!-- 航向P -->
  <arg name="heading_kd"           default="1.0"/>          <!-- 航向D(对tau_d低通后的航向速率) -->
  <arg name="heading_ki"           default="0.0"/>          <!-- 航向I(默认关; 有稳态偏航再加) -->
  <arg name="heading_i_clamp"      default="0.05"/>         <!-- I 积分限幅 -->
  <arg name="heading_omega_limit"  default="0.30"/>         <!-- 总角速度命令限幅(cmd; ×6.4=rad/s) -->
  <arg name="heading_tau_d"        default="0.2"/>          <!-- 航向微分低通时间常数(s) -->
  <arg name="heading_yaw_timeout"  default="0.5"/>          <!-- /imu_heading 陈旧阈值(s) -->
  <arg name="heading_sign"         default="1"/>            <!-- 航向误差极性(0614实测+1=负反馈); 改前必确认符号 -->
  <!-- 外环(距墙/平行)补充 + 速度安全 -->
  <arg name="wall_stale_sec"       default="0.5"/>          <!-- 右侧超声陈旧看门狗(s) -->
  <arg name="wall_consistency_m"   default="0.5"/>          <!-- 右前/右后一致门(m); 超此弃外环纯IMU守航向 -->
  <arg name="speed_max"            default="0.30"/>         <!-- 前进速度安全上限(防打滑临界~0.27) -->
  <arg name="softstart_sec"        default="1.5"/>          <!-- 起步/拐角后 速度+外环C 软启动(s) -->
  <!-- 数据健康门(0701核心): 治偏>10°侧超声"异常增大→OOR"误读区 → 距墙项按合理性淡出, 平行项全权自愈(无状态) -->
  <arg name="wall_max_gap"         default="1.0"/>          <!-- 距墙项淡出量程(m): d>=wall_align+此 距墙项权重=0; ceiling=wall_align+此; 越小越早淡出越保守 -->
  <!-- 拐角(停-转-融合航向闭环) 整定 -->
  <arg name="corner_hard_floor_m"  default="0.40"/>         <!-- 前墙点抵无条件硬停(m)兜底真逼近(补corner_armed下锁窗口) -->
  <arg name="corner_point_blank_confirm" default="2"/>      <!-- 点抵去抖帧: 连续此帧<hard_floor才无条件触发 -->
  <arg name="corner_pb_max"        default="3"/>            <!-- 点抵连发上限: 超此(前方始终未净空)=困死→安全停 -->
  <arg name="corner_front_confirm" default="3"/>            <!-- 前墙连续确认帧 -->
  <arg name="corner_settle_sec"    default="1.0"/>          <!-- 触发后停稳取航向时长(s) -->
  <arg name="corner_turn_deg"      default="90"/>           <!-- 闭环左转目标角(deg) -->
  <arg name="corner_turn_omega"    default="0.2"/>          <!-- 粗转角速度(cmd) -->
  <arg name="corner_turn_omega_fine" default="0.10"/>       <!-- 近目标降速(cmd; 水下过低会停在~88°) -->
  <arg name="corner_slow_deg"      default="15"/>           <!-- 距目标此角内降fine -->
  <arg name="corner_turn_timeout"  default="8.0"/>          <!-- 转向硬超时(s) -->
  <arg name="corner_turn_cap_deg"  default="130"/>          <!-- odom过转兜底上限(deg) -->
  <!-- 电机卡死看门狗(0701): 命令前进却位姿不动→安全停(治0622右轮卡死81s无检测) -->
  <arg name="stall_enable"         default="true"/>         <!-- 总开关 -->
  <arg name="stall_min_speed"      default="0.05"/>         <!-- 位姿速度阈(m/s)判"没推进"(正常~0.17,卡死~0.024) -->
  <arg name="stall_timeout_sec"    default="8.0"/>          <!-- 低于阈持续超此→停(s) -->

  <!-- move_controller 整定参数: 必须置"全局"(顶层 <param>), 否则被忽略(见上方命名空间注意) -->
  <param name="wall_align"           value="$(arg wall_align)"/>
  <param name="wall_k_dist"          value="$(arg wall_k_dist)"/>
  <param name="wall_k_par"           value="$(arg wall_k_par)"/>
  <param name="wall_off_max"         value="$(arg wall_off_max)"/>
  <param name="speed"                value="$(arg speed)"/>
  <param name="pump_speed"           value="$(arg pump_speed)"/>
  <param name="corner_use_wall_dist" value="$(arg corner_use_wall_dist)"/>
  <param name="enable_corner"        value="$(arg enable_corner)"/>
  <!-- 0701 新增: 内环PD + 外环补充 + 健康门 + 拐角 + 卡死 全部全局 <param> -->
  <param name="heading_kp"           value="$(arg heading_kp)"/>
  <param name="heading_kd"           value="$(arg heading_kd)"/>
  <param name="heading_ki"           value="$(arg heading_ki)"/>
  <param name="heading_i_clamp"      value="$(arg heading_i_clamp)"/>
  <param name="heading_omega_limit"  value="$(arg heading_omega_limit)"/>
  <param name="heading_tau_d"        value="$(arg heading_tau_d)"/>
  <param name="heading_yaw_timeout"  value="$(arg heading_yaw_timeout)"/>
  <param name="heading_sign"         value="$(arg heading_sign)"/>
  <param name="wall_stale_sec"       value="$(arg wall_stale_sec)"/>
  <param name="wall_consistency_m"   value="$(arg wall_consistency_m)"/>
  <param name="speed_max"            value="$(arg speed_max)"/>
  <param name="softstart_sec"        value="$(arg softstart_sec)"/>
  <param name="wall_max_gap"         value="$(arg wall_max_gap)"/>
  <param name="corner_hard_floor_m"  value="$(arg corner_hard_floor_m)"/>
  <param name="corner_point_blank_confirm" value="$(arg corner_point_blank_confirm)"/>
  <param name="corner_pb_max"        value="$(arg corner_pb_max)"/>
  <param name="corner_front_confirm" value="$(arg corner_front_confirm)"/>
  <param name="corner_settle_sec"    value="$(arg corner_settle_sec)"/>
  <param name="corner_turn_deg"      value="$(arg corner_turn_deg)"/>
  <param name="corner_turn_omega"    value="$(arg corner_turn_omega)"/>
  <param name="corner_turn_omega_fine" value="$(arg corner_turn_omega_fine)"/>
  <param name="corner_slow_deg"      value="$(arg corner_slow_deg)"/>
  <param name="corner_turn_timeout"  value="$(arg corner_turn_timeout)"/>
  <param name="corner_turn_cap_deg"  value="$(arg corner_turn_cap_deg)"/>
  <param name="stall_enable"         value="$(arg stall_enable)"/>
  <param name="stall_min_speed"      value="$(arg stall_min_speed)"/>
  <param name="stall_timeout_sec"    value="$(arg stall_timeout_sec)"/>

  <!-- 沿边控制器: 提供 /move_controller/move_straight + /move_controller/find_wall (读上方全局参数) -->
  <node pkg="sonar_slam" type="move_controller_node" name="move_controller_node" output="screen"/>

  <!-- 声呐采集 mapper: 走固定距离->停->扫一圈->记文件(依照 main), 落智能会话目录; 参数走私有 ~ -->
  <node pkg="sonar_slam" type="multi_position_sonar_mapper" name="multi_position_sonar_mapper" output="screen">
    <param name="serial_port"             value="$(arg serial_port)"/>
    <param name="baudrate"                value="$(arg baudrate)"/>
    <param name="range_level"             value="$(arg range_level)"/>
    <param name="phase1/enabled"          value="true"/>
    <param name="phase1/num_positions"    value="$(arg num_positions)"/>
    <param name="phase1/move_distance"    value="$(arg move_distance)"/>
    <param name="phase1/scan_duration"    value="$(arg scan_duration)"/>
    <param name="phase1/wait_duration"    value="$(arg wait_duration)"/>
    <param name="phase1/acquire_wall_first" value="$(arg acquire_wall_first)"/>
    <param name="phase1/acquire_distance" value="$(arg acquire_distance)"/>
    <param name="enable_stitch"           value="$(arg enable_stitch)"/>   <!-- 私有 ~enable_stitch: 采集完成是否发 /sonar_scan/session_done -->
  </node>

  <!-- 拼图节点(离线后处理, 受 enable_stitch 门控): 订阅 /sonar_scan/session_done -> 对会话目录跑 sonar_stitch.py
       -> 出 <session>/stitching.pcd -> 发 /sonar_stitch/cloud(RViz) /sonar_stitch/done。
       需机上装 open3d/scipy/pandas/numpy; 缺依赖会打 ASCII 提示并跳过, 不影响采集。 -->
  <node if="$(arg enable_stitch)" pkg="sonar_slam" type="sonar_stitch_node.py"
        name="sonar_stitch_node" output="screen"/>

</launch>
