<?xml version="1.0"?>
<launch>
    <!-- 参数设置 -->
    <arg name="data_file" default="$(find sonar_slam)/data/test2.bin" />
    <arg name="rviz" default="true" />
    
    <!-- 启动声纳数据处理器 -->
    <node pkg="sonar_slam" type="sonar_data_processor" name="sonar_data_processor" output="screen">
        <param name="data_file" value="$(arg data_file)" />
        <param name="max_range" value="15.0" />
        <param name="min_range" value="0.2" />
        <param name="intensity_threshold" value="100" />
    </node>
    
    <!-- 启动gmapping -->
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
        <param name="maxUrange" value="12.0" />
        <param name="maxRange" value="15.0" />
        <param name="particles" value="30" />
        <param name="delta" value="0.05" />
        <param name="xmin" value="-10.0" />
        <param name="xmax" value="10.0" />
        <param name="ymin" value="-10.0" />
        <param name="ymax" value="10.0" />
        <param name="sigma" value="0.1" />
        <param name="lstep" value="0.05" />
        <param name="astep" value="0.05" />
        <param name="linearUpdate" value="1.0" />
        <param name="angularUpdate" value="0.5" />
        <remap from="scan" to="/sonar_scan" />
    </node>
    
    <!-- 启动RViz -->
    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz" 
              args="-d $(find sonar_slam)/config/mapping.rviz" />
    </group>
    
</launch>