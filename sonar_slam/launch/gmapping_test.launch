<launch>
    <arg name="rviz" default="true" />
    <arg name="use_sim_time" default="false" />
    
    <!-- 设置use_sim_time参数 -->
    <param name="/use_sim_time" value="$(arg use_sim_time)" />
    
    <!-- ========== 声纳实时建图 ========== -->
    <node name="sonar_realtime_mapper" pkg="sonar_slam" type="sonar_realtime_mapper" output="screen">
        <param name="serial_port" value="/dev/ttyACM0" />
        <param name="max_range" value="12.0" />
        <param name="min_range" value="0.3" />
        <!-- 【关键】必须发布Pose2DArray格式 -->
        <param name="publish_pose_array" value="true" />
        <param name="publish_pointcloud" value="false" />  <!-- Gmapping不需要点云 -->
    </node>
    
    <!-- ========== 声纳转激光扫描 ========== -->
    <!-- 【关键修改】type应该是sonar_to_laserscan_node -->
    <node name="sonar_to_laserscan" pkg="sonar_slam" type="sonar_to_laserscan_node" output="screen">
        <param name="input_topic" value="/sonar/pose_array" />
        <param name="output_topic" value="/sonar/scan" />
        <!-- 传递给SonarToLaserScan类的参数 -->
        <param name="laser_range_min" value="0.3" />
        <param name="laser_range_max" value="12.0" />
        <param name="laser_angle_min" value="-1.5708" />   <!-- -π/2 -->
        <param name="laser_angle_max" value="1.5708" />    <!-- π/2 -->
        <param name="laser_angle_increment" value="0.0349" /> <!-- 2度 -->
        <param name="enable_filter" value="true" />
    </node>
    
    <!-- ========== TF静态变换 ========== -->
    <!-- 声纳在机器人上的位置 -->
    <node pkg="tf" type="static_transform_publisher" name="base_to_sonar" 
          args="0.2 0 0.1 0 0 0 base_link sonar_link 100" />
    
    <!-- ========== Gmapping SLAM ========== -->
    <node name="gmapping" pkg="gmapping" type="slam_gmapping" output="screen">
        <!-- 必须remap -->
        <remap from="scan" to="/sonar/scan" />
        
        <!-- 【关键】坐标系设置 -->
        <param name="base_frame" value="base_link" />
        <param name="odom_frame" value="odom" />
        <param name="map_frame" value="map" />
        
        <!-- 加载参数配置文件 -->
        <rosparam command="load" file="$(find sonar_slam)/config/gmapping_sonar.yaml" />
        
        <!-- 额外参数（覆盖yaml文件） -->
        <param name="maxRange" value="12.0" />
        <param name="maxUrange" value="10.0" />
        <param name="sigma" value="0.2" />
        <param name="particles" value="30" />
        <param name="minimumScore" value="50.0" />
        <param name="linearUpdate" value="1.5" />
        <param name="angularUpdate" value="0.5" />
        <param name="temporalUpdate" value="3.0" />
        
        <!-- 地图参数 -->
        <param name="xmin" value="-15.0" />
        <param name="xmax" value="15.0" />
        <param name="ymin" value="-15.0" />
        <param name="ymax" value="15.0" />
        <param name="delta" value="0.1" />
    </node>
    
    <!-- ========== 机器人控制（测试用） ========== -->
    <node name="teleop" pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" 
          output="screen">
        <remap from="cmd_vel" to="/cmd_vel" />
    </node>
    
    <!-- ========== RViz可视化 ========== -->
    <node name="rviz" pkg="rviz" type="rviz" 
          args="-d $(find sonar_slam)/config/gmapping_test.rviz" 
          if="$(arg rviz)" output="screen" />
    
    <!-- ========== 地图保存服务 ========== -->
    <node name="map_saver" pkg="map_server" type="map_saver" respawn="false" output="screen">
        <remap from="map" to="/map" />
        <param name="frame_id" value="map" />
    </node>
    
</launch>