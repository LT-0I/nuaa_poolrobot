<launch>
  <!-- ====== [vcu] 简化版 VCU 可调参数（全局命名空间，对应 hardware_driver 的 nh_.param）======
       命令行覆盖即可，免改文件、免重编。例（车总向左偏，加右补偿）：
         roslaunch mars_serial_server serial_server.launch track_bias:=0.03
       默认值=保持现行为（×6.4/×230 历史标定、track_bias=0 不补偿）→ 与旧码逐位等价、0613 直线不受影响。
       改完看驱动启动 banner "[vcu] hardware_driver VCU-v1-20260613 ..." 确认实际生效值（自验闸门）。
         omega_gain      转向增益(替代写死6.4)     默认6.4    范围1.0~6.4
         track_bias      左右履带静态偏置补偿        默认0.0    范围-0.15~+0.15（>0 治"总向左偏"，步长0.01~0.02）
         motor_scale     电机标度(替代写死230)      默认230.0  按实车标定
         max_track_speed 履带速度限幅(m/s)          默认1.0    仅兜失控（正常峰值~0.65-0.82）
         max_motor_cmd   电机命令限幅               默认300    待MCU安全上限确认后回填
         cmd_vel_timeout 看门狗超时(s)              默认0.5    近壁可收紧到0.2~0.3（勿短于cmd_vel发布周期）
       ⚠ 看门狗"零帧=真停车"取决于MCU、未经现场证实，不等于消除失控风险；唯一可靠停车仍是断电。
       ⚠ 范围：被改的是 /cmd_vel 路径——键控/走直线 heading_straight/沿边 move_controller(实发 /cmd_vel)都经此，故 omega_gain/track_bias/限幅/看门狗对沿边也生效；未覆盖 /autoVel_cmd(motion_controller 备用+矩形巡走)。看门狗 0.5s 超时勿短于任一 /cmd_vel 发布方的最长缺口(move_controller 主动行走≤0.3s安全，启用沿边前复核)。 -->
  <arg name="omega_gain"      default="6.4"/>
  <arg name="track_bias"      default="0.0"/>
  <arg name="motor_scale"     default="230.0"/>
  <arg name="max_track_speed" default="1.0"/>
  <arg name="max_motor_cmd"   default="300"/>
  <arg name="cmd_vel_timeout" default="0.5"/>
  <param name="omega_gain"      value="$(arg omega_gain)"/>
  <param name="track_bias"      value="$(arg track_bias)"/>
  <param name="motor_scale"     value="$(arg motor_scale)"/>
  <param name="max_track_speed" value="$(arg max_track_speed)"/>
  <param name="max_motor_cmd"   value="$(arg max_motor_cmd)"/>
  <param name="cmd_vel_timeout" value="$(arg cmd_vel_timeout)"/>

  <node pkg="mars_serial_server" type="serial_server_exe" name="serial_server_node" respawn="true" respawn_delay="10" output="screen">
    <param name="port" value="/dev/ttyS0"/>
    <param name="baud" value="115200"/>
  </node>

<!-- <node pkg="serial_demo" type="serial_demo" name="serial_port" respawn="true" respawn_delay="1" output="screen">
    <param name="port" value="/dev/ttyUSB0"/>
    <param name="baud" value="57600"/>
  </node> -->
\

  <!-- <node name="base_imu_link" pkg="tf" type="static_transform_publisher" args="0 0 0 0 0 0 /base_footprint /imu_link 50"/> -->

</launch>
