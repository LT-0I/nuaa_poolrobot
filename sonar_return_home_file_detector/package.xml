<?xml version="1.0"?>
<package format="2">
  <name>sonar_return_home_file_detector</name>
  <version>0.1.0</version>
  <description>Drop-in file-directory return-home detector for sonar_slam snapshots.</description>

  <maintainer email="maintainer@example.invalid">Sonar Return Home Maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>pcl_conversions</build_depend>

  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>pcl_ros</build_export_depend>
  <build_export_depend>pcl_conversions</build_export_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>pcl_conversions</exec_depend>

  <build_depend>libpcl-dev</build_depend>
  <build_depend>libeigen3-dev</build_depend>
  <build_depend>libfftw3-dev</build_depend>
  <build_depend>libcgal-dev</build_depend>
  <build_depend>libopencv-dev</build_depend>
  <build_depend>libgmp-dev</build_depend>
  <build_depend>libmpfr-dev</build_depend>

  <exec_depend>libpcl-dev</exec_depend>
  <exec_depend>libeigen3-dev</exec_depend>
  <exec_depend>libfftw3-dev</exec_depend>
  <exec_depend>libcgal-dev</exec_depend>
  <exec_depend>libopencv-dev</exec_depend>
  <exec_depend>libgmp-dev</exec_depend>
  <exec_depend>libmpfr-dev</exec_depend>
</package>
